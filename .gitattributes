# 统一换行与文本判定：避免 Windows 工作区把 CRLF 带进 commit
* text=auto eol=lf
*.py    text eol=lf
*.ps1   text eol=lf
*.R     text eol=lf
*.md    text eol=lf
*.cff   text eol=lf
*.json  text eol=lf
*.csv   text eol=lf
*.sh    text eol=lf
*.txt   text eol=lf
*.npz   binary
*.pth   binary
*.png   binary
*.pdf   binary
MANIFEST.sha256       text eol=lf
MANIFEST.data.sha256  text eol=lf